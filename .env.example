# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password for /blog/admin — make it long.
ADMIN_PASSWORD=

# Resend → API Keys. EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Niharika Patil <blog@your-domain.com>

# Your live site address, used in share links and emails.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Google Analytics → Admin → Data streams → your stream → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
